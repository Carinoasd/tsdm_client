<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget, drawn by HomeWidgetProvider: unread notices, unread personal messages, check-in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_widget_notice_count"
            style="@style/HomeWidgetCount"
            android:text="0" />

        <TextView
            style="@style/HomeWidgetLabel"
            android:text="@string/home_widget_notice" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_widget_pm_count"
            style="@style/HomeWidgetCount"
            android:text="0" />

        <TextView
            style="@style/HomeWidgetLabel"
            android:text="@string/home_widget_personal_message" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_widget_checkin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/home_widget_button"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/home_widget_checkin_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home_widget_unchecked" />

        <TextView
            android:id="@+id/home_widget_checkin_label"
            style="@style/HomeWidgetLabel"
            android:layout_marginTop="2dp"
            android:text="@string/home_widget_not_checked_in" />
    </LinearLayout>
</LinearLayout>
