  "document": "\r\n<div class=\"tm_c\" id=\"floatlayout_topicadmin\">\r\n<h3 class=\"flb\">\r\n<em id=\"return_mods\">选择了 1 篇帖子</em>\r\n<span>\r\n<a href=\"javascript:;\" class=\"flbc\" onclick=\"hideWindow('mods')\" title=\"关闭\">关闭</a>\r\n</span>\r\n</h3>\r\n<form id=\"topicadminform\" method=\"post\" autocomplete=\"off\" action=\"forum.php?mod=topicadmin&amp;action=delpost&amp;modsubmit=yes&amp;infloat=yes&amp;modclick=yes\" onsubmit=\"ajaxpost('topicadminform', 'return_mods', 'return_mods', 'onerror');return false;\">\r\n<input type=\"hidden\" name=\"formhash\" value=\"f1f2f3f4\" />\r\n<input type=\"hidden\" name=\"fid\" value=\"10\">\r\n<input type=\"hidden\" name=\"tid\" value=\"1234567\">\r\n<input type=\"hidden\" name=\"handlekey\" value=\"mods\" /><div class=\"c\">\r\n<div class=\"tplw\">\r\n<input type=\"hidden\" name=\"topiclist[]\" value=\"7654321\" />删除选定帖子\r\n\r\n</div>\r\n<div class=\"tpclg\">\r\n<h4>\r\n<a onclick=\"showselect(this, 'reason', 'reasonselect')\" class=\"dpbtn y\" href=\"javascript:;\">^</a>\r\n操作说明:\r\n</h4>\r\n<p><textarea name=\"reason\" id=\"reason\" class=\"pt\" onkeyup=\"seditor_ctlent(event, '$(\\'modsubmit\\').click()')\"></textarea></p>\r\n<ul id=\"reasonselect\" style=\"display: none\"><li>广告/SPAM</li><li>恶意灌水</li><li>违规内容</li><li>文不对题</li><li>重复发帖</li><li>--------</li><li>我很赞同</li><li>精品文章</li><li>原创内容</li></ul>\r\n</div>\r\n</div>\r\n            <div class=\"c\">\r\n            <div class=\"tpclg\">\r\n            <h4 class=\"cl\">\r\n                <p class=\"y\">\r\n                    <label for=\"userban\"><input type=\"checkbox\" name=\"banuser\" id=\"userban\" class=\"pc\" />禁言</label>\r\n                    <label for=\"userdelpost\"><input type=\"checkbox\" name=\"userdelpost\" id=\"userdelpost\" class=\"pc\" />清空帖子</label>\r\n                </p>\r\n                <span>用户操作:</span>\r\n            </h4>\r\n        </div>\r\n        </div>\r\n    <div class=\"o pns\">\r\n<label for=\"crimerecord\"><input type=\"checkbox\" name=\"crimerecord\" id=\"crimerecord\" class=\"pc\" />违规登记</label>\r\n<label for=\"sendreasonpm\"><input type=\"checkbox\" name=\"sendreasonpm\" id=\"sendreasonpm\" class=\"pc\" />通知作者</label>\r\n<button type=\"submit\" name=\"modsubmit\" id=\"modsubmit\" value=\"ture\" class=\"pn pnc\"><span>确定</span></button>\r\n</div>\r\n</form>\r\n</div>\r\n<script type=\"text/javascript\" reload=\"1\">\r\nfunction succeedhandle_mods(locationhref) {\r\nhideWindow('mods');\r\nlocation.href = locationhref;\r\n}\r\nif($('copyto')) {\r\najaxget('forum.php?mod=ajax&action=getthreadtypes&fid=' + $('copyto').value, 'threadtypes');\r\n}\r\n</script>\r\n\r\n"
