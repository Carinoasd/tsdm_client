{"ok":1,"api":1,"time":1794541830,"uid":31,"formhash":"f1f2f3f4","type":"result","schema":13,"kind":"page","message":"","message_key":"","url":"","handlekey":"","values":{},"login":0,"alert":"","document":"\r\n<form id=\"magicform\" method=\"post\" action=\"home.php?mod=magic&amp;action=shop&amp;infloat=yes\" onsubmit=\"ajaxpost('magicform', 'return_magics', 'return_magics', 'onerror');return false;\">\r\n<div class=\"f_c\">\r\n<h3 class=\"flb\">\r\n<em id=\"return_magics\">\r\n购买道具\r\n</em>\r\n<span><a href=\"javascript:;\" class=\"flbc\" onclick=\"hideWindow('magics');return false;\" title=\"关闭\">关闭</a></span>\r\n</h3>\r\n<div class=\"c\">\r\n<input type=\"hidden\" name=\"formhash\" value=\"f1f2f3f4\" />\r\n<input type=\"hidden\" name=\"handlekey\" value=\"magics\" /><input type=\"hidden\" name=\"operation\" value=\"buy\" />\r\n<input type=\"hidden\" name=\"mid\" value=\"prankmagic:pkname\" />\r\n<dl class=\"xld cl\">\r\n<dd class=\"m\">\r\n<div class=\"mg_img\"><img src=\"source/plugin/prankmagic/magic/magic_pkname.gif\" alt=\"\" /></div>\r\n</dd>\r\n<dt class=\"z\">\r\n<div class=\"mbm pbm bbda\">\r\n<p>改名牌卡</p>\r\n<p class=\"mtn xw0 xg1\">对某人使用：一段时间内他的名字旁会挂上一块你写的称号牌（例如【今天没洗澡】）。称号有字数限制，并会经过站内屏蔽词检查。</p>\r\n<p class=\"mtm xw0 mbn\">售价: <span>天使币 <span class=\"xi1 xw1 xs2\" id=\"magicprice\">1</span> </span></p>\r\n<p class=\"xw0 xg1\">我目前有天使币 1504 </p>\r\n<p class=\"mtm xw0 mbn\">重量: <span class=\"xi1 xw1 xs2\" id=\"magicweight\">10</span></p>\r\n<p class=\"xw0 xg1\">我的道具包可用容量 80</p>\r\n</div>\r\n<div class=\"xw0\">\r\n<p class=\"mtn xw0\">库存: <span class=\"xi1 xw1 xs2\">996</span> 张</p>\r\n<p class=\"mtn\">购买 <input id=\"magicnum\" name=\"magicnum\" type=\"text\" size=\"2\" autocomplete=\"off\" value=\"1\" class=\"px pxs\" onkeyup=\"compute();\" /> 张</p>\r\n</div>\r\n</dt>\r\n</dl>\r\n<input type=\"hidden\" name=\"operatesubmit\" value=\"yes\" />\r\n</div>\r\n</div>\r\n<div class=\"o pns\">\r\n<button class=\"pn pnc\" type=\"submit\" name=\"operatesubmit\" id=\"operatesubmit\" value=\"true\"><span>购买</span></button>\r\n</div>\r\n</form>\r\n\r\n<script type=\"text/javascript\" reload=\"1\">\r\nfunction succeedhandle_magics(url, msg) {\r\nhideWindow('magics');\r\nshowDialog(msg, 'notice', null, function () { location.href=url; }, 0);\r\nshowCreditPrompt();\r\n}\r\nfunction confirmMagicOp(e) {\r\ne = e ? e : window.event;\r\nshowDialog('确认该操作', 'confirm', '', 'ajaxpost(\\'magicform\\', \\'return_magics\\', \\'return_magics\\', \\'onerror\\');');\r\ndoane(e);\r\nreturn false;\r\n}\r\nfunction compute() {\r\nvar totalcredit = 1504;\r\nvar totalweight = 80;\r\nvar magicprice = $('magicprice').innerHTML;\r\nif($('discountprice')) {\r\nmagicprice = $('discountprice').innerHTML;\r\n}\r\nif(isNaN(parseInt($('magicnum').value))) {\r\n$('magicnum').value = 0;\r\nreturn;\r\n}\r\nif(!$('magicnum').value || totalcredit < 1 || totalweight < 1) {\r\n$('magicnum').value = 0;\r\nreturn;\r\n}\r\nvar curprice = $('magicnum').value * magicprice;\r\nvar curweight = $('magicnum').value * $('magicweight').innerHTML;\r\nif(curprice > totalcredit) {\r\n$('magicnum').value = parseInt(totalcredit / magicprice);\r\n} else if(curweight > totalweight) {\r\n$('magicnum').value = parseInt(totalweight / $('magicweight').innerHTML);\r\n}\r\n$('magicnum').value = parseInt($('magicnum').value);\r\n}\r\n</script>\r\n\r\n"}