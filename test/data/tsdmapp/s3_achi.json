adius:8px;position:relative;overflow:hidden;background:linear-gradient(170deg,#d1302f,#b82a29)}\n.float-hb .body::before{content:\"\";position:absolute;top:0;left:0;right:0;height:34px;background:rgba(255,255,255,.1);border-radius:0 0 50% 50%/0 0 16px 16px}\n.float-hb .dot{position:absolute;top:22px;left:50%;transform:translateX(-50%);width:22px;height:22px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffedbe,#f4d493 60%,#e5bd72)}\n.float-hb .lbl{position:absolute;bottom:7px;width:100%;text-align:center;color:#fdeede;font-size:11px;letter-spacing:1px}\n</style>\n<div class=\"mask\" id=\"hb_mask\">\n  <div class=\"fx-night\" id=\"hb_night\"></div>\n  <div class=\"fx-flash\" id=\"hb_flash\"></div>\n  <canvas class=\"fx-canvas\" id=\"hb_fx\"></canvas>\n  <div class=\"env-wrap\">\n    <div class=\"fx-rays\" id=\"hb_rays\"></div>\n    <div class=\"fx-ring\" id=\"hb_ring\"></div>\n    <div class=\"env\" id=\"hb_env\">\n      <div class=\"flap\"></div>\n      <div class=\"from\" id=\"hb_from\"></div>\n      <div class=\"bless\" id=\"hb_bless\"></div>\n      <div class=\"pwbox\"><input type=\"text\" id=\"hb_pw\" placeholder=\"輸入口令\" maxlength=\"64\" autocomplete=\"off\"><div class=\"pwerr\" id=\"hb_pwerr\"></div></div>\n      <button class=\"open-btn\" id=\"hb_openbtn\" onclick=\"hongbaoDoOpen()\">開</button>\n      <button class=\"wd-btn\" id=\"hb_wdbtn\" onclick=\"hongbaoWithdraw()\" style=\"display:none\">撤回<br>剩餘</button>\n      <div class=\"inner\">\n        <div class=\"who\" id=\"hb_who\"></div>\n        <div class=\"bless2\" id=\"hb_bless2\"></div>\n        <div class=\"amt\" id=\"hb_amt\"></div>\n        <div class=\"unit\" id=\"hb_unit\"></div>\n        <div class=\"stored\">已存入你的帳戶</div>\n        <div class=\"reclink\" id=\"hb_reclink\" onclick=\"hongbaoToggleRecs()\">看看大家的手氣 ›</div>\n        <div class=\"statemsg\" id=\"hb_statemsg\"></div>\n      </div>\n      <div class=\"recs\" id=\"hb_recs\"></div>\n    </div>\n    <div class=\"cat\" id=\"hb_cat\"></div>\n    <div class=\"bigtag\" id=\"hb_bigtag\">手 氣 爆 發 !</div>\n    <button class=\"env-close\" onclick=\"hongbaoClose()\">✕</button>\n    <label class=\"daily-skip\" id=\"hb_dailyskip\" style=\"display:none\"><input type=\"checkbox\" id=\"hb_skipchk\"> 今日不再顯示</label>\n  </div>\n</div>\n<script>\n(function(){\nif(window.hongbaoOpen) return;\nvar HB={base:'plugin.php?id=hongbao:',fh:'d0bf9e72',cur:null,cat:'🐱',fxmode:'random'};\nfunction $(id){return document.getElementById(id);}\nfunction post(url,body){return fetch(url,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body});}\nwindow.hongbaoClose=function(){hbFxStop();$('hb_mask').classList.remove('show');};\n/* ---- 彩蛋特效(1.2.0):閃光＋衝擊波＋光芒＋震動＋金幣與彩帶爆發＋金幣雨＋數字跳動。純前端,不影響賬務。 ---- */\nvar FX={theme:'gold',cx:0,cy:0,small:false,cap:300,t0:0,raf:0,amtRaf:0,amtTarget:null,timers:[],parts:[],ctx:null,w:0,h:0,dpr:1,end:0,rainUntil:0,last:0};\nfunction hbReduced(){ try{ return window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){ return false; } }\nfunction hbFxStop(){\n  if(FX.raf){ cancelAnimationFrame(FX.raf); FX.raf=0; }\n  if(FX.amtRaf){ cancelAnimationFrame(FX.amtRaf); FX.amtRaf=0; if(FX.amtTarget!==null){ $('hb_amt').textContent=String(FX.amtTarget); } }\n  FX.amtTarget=null;\n  FX.timers.forEach(clearTimeout); FX.timers=[]; FX.parts=[];\n  var c=$('hb_fx'); if(c){ c.style.display='none'; if(FX.ctx){ FX.ctx.clearRect(0,0,c.width,c.height); } }\n  ['hb_flash','hb_ring'].forEach(function(i){ var e=$(i); if(e){ e.classList.remove('go'); } });\n  var r=$('hb_rays'); if(r){ r.classList.remove('go','out'); }\n  var nt=$('hb_night'); if(nt){ nt.classList.remove('go','out'); }\n  var env=$('hb_env'); if(env){ env.classList.remove('hit'); }\n  var a=$('hb_amt'); if(a){ a.classList.remove('fxglow'); }\n}\nfunction hbLater(fn,ms){ FX.timers.push(setTimeout(fn,ms)); }\nfunction hbRestart(el,cls){ el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); }\n/* 主題：tag＝印章文字；f/r/g＝閃光、光芒、衝擊波顏色（RGB）；night＝夜空暗幕 */\nvar HB_THEMES={\n  gold:{tag:'手 氣 爆 發 !',f:'255,214,90',r:'255,220,120',g:'255,226,140',night:0},\n  firework:{tag:'大 吉 大 利 !',f:'255,250,235',r:'150,170,255',g:'210,220,255',night:1},\n  sakura:{tag:'好 運 綻 放 !',f:'255,200,222',r:'255,170,205',g:'255,205,228',night:0},\n  thunder:{tag:'天 降 鴻 運 !',f:'190,205,255',r:'130,150,255',g:'170,210,255',night:1},\n  rain:{tag:'紅 包 雨 來 !',f:'255,150,120',r:'255,200,120',g:'255,215,140',night:0}\n};\nvar HB_THEME_KEYS=['gold','firework','sakura','thunder','rain'];\nfunction hbPickTheme(){\n  var m=HB.fxmode;\n  if(HB_THEMES[m]) return m;\n  var last=''; try{ last=localStorage.getItem('hb_fx_last')||''; }catch(e){}\n  var pool=HB_THEME_KEYS.filter(function(k){ return k!==last; });\n  var k=pool[(Math.random()*pool.length)|0];\n  try{ localStorage.setItem('hb_fx_last',k); }catch(e){}\n  return k;\n}\nfunction hbFx(amount){\n  hbFxStop();\n  var env=$('hb_env'), amt=$('hb_amt'), mask=$('hb_mask');\n  var key=hbPickTheme(), T=HB_THEMES[key];\n  FX.theme=key;\n  $('hb_bigtag').textContent=T.tag;\n  mask.style.setProperty('--fxf',T.f); mask.style.setProperty('--fxr',T.r); mask.style.setProperty('--fxg',T.g);\n  if(hbReduced()){ return; }\n  if(T.night){ hbRestart($('hb_night'),'go'); }\n  hbRestart($('hb_flash'),'go'); hbRestart($('hb_ring'),'go'); hbRestart($('hb_rays'),'go'); hbRestart(env,'hit');\n  // 數字從 0 跳到金額\n  var target=parseInt(amount,10)||0, t0=performance.now(), dur=1100;\n  amt.textContent='0'; FX.amtTarget=target;\n  (function tick(now){\n    var k=Math.min(1,(now-t0)/dur), e=1-Math.pow(1-k,3);\n    amt.textContent=String(Math.round(target*e));\n    if(k<1){ FX.amtRaf=requestAnimationFrame(tick); } else { FX.amtRaf=0; FX.amtTarget=null; amt.textContent=String(target); hbRestart(amt,'fxglow'); }\n  })(t0);\n  var c=$('hb_fx'); if(!c||!c.getContext) return;\n  FX.dpr=Math.min(2,window.devicePixelRatio||1); FX.w=window.innerWidth; FX.h=window.innerHeight;\n  c.width=FX.w*FX.dpr; c.height=FX.h*FX.dpr; c.style.display='block';\n  FX.ctx=c.getContext('2d'); FX.ctx.setTransform(FX.dpr,0,0,FX.dpr,0,0);\n  var rect=env.getBoundingClientRect();\n  FX.cx=rect.left+rect.width/2; FX.cy=rect.top+rect.height*0.45; FX.small=FX.w<600;\n  FX.cap=FX.small?170:320;\n  var now=performance.now(); FX.t0=now; FX.last=now; FX.rainUntil=now+2600; FX.end=now+(key==='firework'?6500:4800);\n  HB_FX[key].start();\n  hbLater(function(){ $('hb_rays').classList.add('out'); $('hb_night').classList.add('out'); },3700);\n  FX.raf=requestAnimationFrame(hbFrame);\n}\nfunction hbN(n){ return FX.small?Math.ceil(n/2):n; }\nfunction rnd(a,b){ return a+Math.random()*(b-a); }\nfunction hbAdd(p){ if(FX.parts.length<FX.cap) FX.parts.push(p); return p; }\nfunction hbPart(t,x,y,vx,vy,o){\n  var p={t:t,x:x,y:y,px:x,py:y,vx:vx,vy:vy,rot:Math.random()*6.28,vr:rnd(-.2,.2),spin:Math.random()*6.28,vs:rnd(.15,.4),\n    r:4,col:'#fff',life:0,max:400,g:.2,drag:.99,sway:0};\n  if(o){ for(var k in o){ p[k]=o[k]; } }\n  return p;\n}\nfunction hbRadial(t,n,sp1,sp2,o,up){\n  for(var i=0;i<n;i++){\n    var a=up?(-Math.PI/2+rnd(-1,1)*Math.PI*.75):rnd(0,6.283), sp=rnd(sp1,sp2);\n    var p=hbPart(t,FX.cx,FX.cy,Math.cos(a)*sp,Math.sin(a)*sp-(up?2:0),o?o():null); hbAdd(p);\n  }\n}\nvar HB_CONF=['#ff3b3b','#ffd34d','#ff8a00','#fff1b8','#ff5fa2','#ffffff'];\nvar HB_FWC=['#ff4d4d','#ffd34d','#5cf2ff','#a78bff','#7dff8a','#ff7ad9','#ffffff'];\nfunction coin(){ return {r:rnd(9,16),g:.28,drag:.995}; }\nfunction conf(){ return {r:rnd(4,8),g:.16,drag:.985,sway:1,col:HB_CONF[(Math.random()*6)|0]}; }\nfunction spark(col){ return function(){ return {r:rnd(2,5),g:.05,drag:.93,max:rnd(40,70),col:col||'#fff3c4'}; }; }\nvar HB_FX={\n  gold:{\n    start:function(){ hbRadial('coin',hbN(60),5,13,coin,1); hbRadial('conf',hbN(80),5,14,conf,1); hbRadial('spark',hbN(26),7,15,spark(),1); },\n    tick:function(now,dt){\n      if(now<FX.rainUntil && Math.random()<.7*dt){ var c=Math.random()<.65; hbAdd(hbPart(c?'coin':'conf',rnd(0,FX.w),-20,rnd(-1,1),rnd(2,5),c?coin():conf())); }\n    }\n  },\n  firework:{\n    start:function(){\n      hbRadial('ember',hbN(60),3,9,function(){ return {r:rnd(1.6,2.8),g:.05,drag:.965,max:rnd(55,85),col:HB_FWC[(Math.random()*7)|0]}; });\n      var n=FX.small?5:8;\n      for(var i=0;i<n;i++){ (function(i){ hbLater(function(){\n        var x=rnd(FX.w*.12,FX.w*.88), ty=rnd(FX.h*.12,FX.h*.42);\n        hbAdd(hbPart('rocket',x,FX.h+10,rnd(-.8,.8),-Math.sqrt(2*.16*(FX.h-ty)),{r:2.4,g:.16,drag:1,max:200,col:HB_FWC[(Math.random()*7)|0]}));\n      },150+i*rnd(230,330)); })(i); }\n    },\n    tick:function(){},\n    rocketDone:function(p){\n      var n=hbN((Math.random()*40+60)|0), col=p.col, col2=HB_FWC[(Math.random()*7)|0], ring=Math.random()<.35;\n      for(var i=0;i<n;i++){\n        var a=i/n*6.283+rnd(-.05,.05), sp=ring?rnd(5.2,5.8):rnd(1.5,6.5);\n        hbAdd(hbPart('ember',p.x,p.y,Math.cos(a)*sp,Math.sin(a)*sp,{r:rnd(1.5,2.6),g:.06,drag:.965,max:rnd(55,95),col:i%3?col:col2}));\n      }\n      for(i=0;i<hbN(14);i++){ hbAdd(hbPart('spark',p.x,p.y,rnd(-3,3),rnd(-3,3),{r:rnd(1.5,3),g:.03,drag:.95,max:rnd(25,45),col:'#ffffff'})); }\n    }\n  },\n  sakura:{\n    start:function(){ hbRadial('petal',hbN(90),3,10,function(){ return petal(); },0); hbRadial('spark',hbN(18),4,10,spark('#ffe3ef'),1); },\n    tick:function(now,dt){\n      if(now<FX.rainUntil+600 && Math.random()<.8*dt){ hbAdd(hbPart('petal',rnd(-FX.w*.2,FX.w),-20,rnd(1,3),rnd(1,2.5),petal())); }\n    }\n  },\n  thunder:{\n    start:function(){\n      [0,240,620,1100,1700,2300].forEach(function(ms,i){ hbLater(function(){ hbBolt(i===0); if(i){ hbRestart($('hb_flash'),'go'); } },ms); });\n      hbRadial('spark',hbN(50),6,16,spark('#cfe0ff'),0);\n      hbRadial('ember',hbN(40),3,10,function(){ return {r:rnd(1.4,2.4),g:.04,drag:.94,max:rnd(30,55),col:Math.random()<.5?'#8fb4ff':'#e6d2ff'}; });\n    },\n    tick:function(now,dt){\n      if(now<FX.rainUntil && Math.random()<.25*dt){\n        var a=rnd(0,6.283), d=rnd(150,230);\n        hbAdd(hbPart('spark',FX.cx+Math.cos(a)*d,FX.cy+Math.sin(a)*d*1.3,-Math.cos(a)*3,-Math.sin(a)*3,{r:rnd(1.5,3),g:0,drag:.9,max:rnd(15,30),col:'#bcd3ff'}));\n      }\n    }\n  },\n  rain:{\n    start:function(){ hbRadial('env',hbN(26),5,12,function(){ return {r:rnd(10,15),g:.26,drag:.99}; },1); hbRadial('coin',hbN(30),5,12,coin,1); hbRadial('spark',hbN(20),6,14,spark(),1); },\n    tick:function(now,dt){\n      if(now<FX.rainUntil+400 && Math.random()<.9*dt){ var e=Math.random()<.75; hbAdd(hbPart(e?'env':'coin',rnd(0,FX.w),-30,rnd(-.6,.6),rnd(2,4.5),e?{r:rnd(10,16),g:.12,drag:.985,sway:1}:coin())); }\n    }\n  }\n};\nfunction petal(){ return {r:rnd(6,10),g:.04,drag:.985,sway:1,max:420,col:Math.random()<.5?'#ffb7d0':'#ffd3e2'}; }\nfunction hbBolt(main){\n  var x0=main?FX.cx+rnd(-40,40):rnd(FX.w*.15,FX.w*.85), y0=-10, x1=FX.cx+rnd(-30,30), y1=FX.cy-40;\n  var pts=[[x0,y0]], n=12;\n  for(var i=1;i<n;i++){ var k=i/n; pts.push([x0+(x1-x0)*k+rnd(-38,38),y0+(y1-y0)*k+rnd(-10,10)]); }\n  pts.push([x1,y1]);\n  var br=[]; for(i=3;i<n-2;i+=3){ var s=pts[i], q=[s]; for(var j=1;j<4;j++){ q.push([s[0]+rnd(-30,30)*j*.6+(Math.random()<.5?-1:1)*j*14,s[1]+j*rnd(14,26)]); } br.push(q); }\n  hbAdd(hbPart('bolt',0,0,0,0,{pts:pts,br:br,max:main?32:24,g:0}));\n}\nfunction hbFrame(now){\n  var g=FX.ctx, dt=Math.min(2.5,(now-FX.last)/16.67); FX.last=now;\n  g.clearRect(0,0,FX.w,FX.h);\n  var th=HB_FX[FX.theme]; if(th&&th.tick) th.tick(now,dt);\n  var keep=[];\n  for(var i=0;i<FX.parts.length;i++){\n    var p=FX.parts[i]; p.life+=dt; p.px=p.x; p.py=p.y;\n    var dr=Math.pow(p.drag,dt);\n    p.vx*=dr; p.vy=p.vy*dr+p.g*dt;\n    if(p.sway){ p.vx+=Math.sin(p.life*.1+p.spin)*.09*dt; }\n    p.x+=p.vx*dt; p.y+=p.vy*dt; p.rot+=p.vr*dt; p.spin+=p.vs*dt;\n    if(p.t==='rocket' && p.vy>=-.6){ HB_FX.firework.rocketDone(p); continue; }\n    if(p.y>FX.h+50||p.life>p.max) continue;\n    keep.push(p); hbDraw(g,p);\n  }\n  FX.parts=keep;\n  if(now<FX.end && (keep.length||now<FX.rainUntil||FX.timers.length)){ FX.raf=requestAnimationFrame(hbFrame); }\n  else { hbFxStop(); }\n}\nfunction hbDraw(g,p){\n  g.save();\n  var t=p.t, al;\n  if(t==='coin'){\n    g.translate(p.x,p.y); var sx=Math.abs(Math.cos(p.spin)); g.rotate(p.rot*.3); g.scale(Math.max(.08,sx),1);\n    var gr=g.createRadialGradient(-p.r*.35,-p.r*.35,p.r*.1,0,0,p.r);\n    gr.addColorStop(0,'#fff6c8'); gr.addColorStop(.45,'#ffd34d'); gr.addColorStop(1,'#c98a14');\n    g.fillStyle=gr; g.beginPath(); g.arc(0,0,p.r,0,6.283); g.fill();\n    g.lineWidth=1.6; g.strokeStyle='rgba(150,95,10,.85)'; g.beginPath(); g.arc(0,0,p.r*.66,0,6.283); g.stroke();\n    if(sx>.55){ g.fillStyle='rgba(255,255,255,.8)'; g.fillRect(-p.r*.12,-p.r*.45,p.r*.24,p.r*.9); }\n  } else if(t==='conf'){\n    g.translate(p.x,p.y); g.rotate(p.rot); g.scale(1,Math.cos(p.spin)); g.fillStyle=p.col; g.fillRect(-p.r,-p.r*.4,p.r*2,p.r*.8);\n  } else if(t==='spark'){\n    g.translate(p.x,p.y); al=Math.max(0,1-p.life/p.max); g.globalCompositeOperation='lighter'; g.globalAlpha=al;\n    var s=p.r*3; g.fillStyle=p.col;\n    g.beginPath(); g.moveTo(0,-s); g.quadraticCurveTo(0,0,s,0); g.quadraticCurveTo(0,0,0,s); g.quadraticCurveTo(0,0,-s,0); g.quadraticCurveTo(0,0,0,-s); g.fill();\n    g.globalAlpha=al*.5; g.beginPath(); g.arc(0,0,p.r*1.6,0,6.283); g.fill();\n  } else if(t==='ember'||t==='rocket'){\n    al=t==='rocket'?1:Math.max(0,1-p.life/p.max); g.globalCompositeOperation='lighter';\n    g.strokeStyle=p.col; g.globalAlpha=al*.55; g.lineWidth=p.r; g.lineCap='round';\n    g.beginPath(); g.moveTo(p.px-(p.x-p.px)*2.5,p.py-(p.y-p.py)*2.5); g.lineTo(p.x,p.y); g.stroke();\n    g.globalAlpha=al; g.fillStyle=t==='rocket'?'#fff8e0':p.col; g.beginPath(); g.arc(p.x,p.y,p.r*(t==='rocket'?1.3:.9),0,6.283); g.fill();\n    if(t==='ember' && p.life>p.max*.6 && Math.random()<.3){ g.globalAlpha=al; g.fillStyle='#fff'; g.fillRect(p.x-1,p.y-1,2,2); }\n  } else if(t==='petal'){\n    g.translate(p.x,p.y); g.rotate(p.rot); g.scale(Math.cos(p.spin),1);\n    al=Math.min(1,Math.max(0,(p.max-p.life)/40)); g.globalAlpha=al;\n    var r=p.r, pg=g.createLinearGradient(0,-r,0,r); pg.addColorStop(0,'#fff0f6'); pg.addColorStop(1,p.col);\n    g.fillStyle=pg; g.beginPath(); g.moveTo(0,-r); g.quadraticCurveTo(r*1.1,-r*.2,0,r); g.quadraticCurveTo(-r*1.1,-r*.2,0,-r); g.fill();\n    g.strokeStyle='rgba(255,140,180,.5)'; g.lineWidth=.8; g.beginPath(); g.moveTo(0,-r*.7); g.lineTo(0,r*.7); g.stroke();\n  } else if(t==='env'){\n    g.translate(p.x,p.y); g.rotate(p.rot*.5); g.scale(Math.max(.15,Math.abs(Math.cos(p.spin))),1);\n    var w=p.r*1.3, h=p.r*1.8;\n    g.fillStyle='#d1302f'; g.fillRect(-w/2,-h/2,w,h);\n    g.fillStyle='#b0221f'; g.beginPath(); g.moveTo(-w/2,-h/2); g.lineTo(w/2,-h/2); g.lineTo(0,-h*.1); g.closePath(); g.fill();\n    g.fillStyle='#f4d493'; g.beginPath(); g.arc(0,-h*.08,w*.2,0,6.283); g.fill();\n    g.strokeStyle='rgba(255,220,150,.6)'; g.lineWidth=1; g.strokeRect(-w/2,-h/2,w,h);\n  } else if(t==='bolt'){\n    al=Math.max(0,1-p.life/p.max); g.globalCompositeOperation='lighter'; g.lineCap='round'; g.lineJoin='round';\n    var draw=function(pts,wd){ g.beginPath(); g.moveTo(pts[0][0],pts[0][1]); for(var i=1;i<pts.length;i++){ g.lineTo(pts[i][0],pts[i][1]); } g.stroke(); };\n    g.globalAlpha=al*.35; g.strokeStyle='#7f9cff'; g.lineWidth=14; draw(p.pts);\n    g.globalAlpha=al*.7; g.strokeStyle='#c5d4ff'; g.lineWidth=5; draw(p.pts);\n    g.globalAlpha=al; g.strokeStyle='#ffffff'; g.lineWidth=2; draw(p.pts);\n    g.globalAlpha=al*.7; g.strokeStyle='#d8e2ff'; g.lineWidth=1.4; p.br.forEach(function(b){ draw(b); });\n  }\n  g.restore();\n}\nwindow.hongbaoOpen=function(el){\n  if(HB.dailyTimer){ clearTimeout(HB.dailyTimer); HB.dailyTimer=null; } // 使用者主動開包時,取消待發的每日彈窗計時器\n  var tid=el.getAttribute('data-tid');\n  fetch(HB.base+'open&tid='+tid,{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(c){\n    if(!c.ok){ alert(c.error||'紅包不存在'); return; }\n    HB.cur=c; HB.cur.el=el;\n    var env=$('hb_env');\n    env.classList.remove('opened','haspw');\n    if(c.haspw) env.classList.add('haspw');\n    $('hb_from').textContent=c.from;\n    $('hb_bless').innerText=(c.bless||'');\n    $('hb_who').textContent=c.from;\n    $('hb_bless2').textContent=(c.bless||'').split('\\\\n')[0];\n    $('hb_unit').textContent=c.unit||'';\n    $('hb_amt').textContent=''; $('hb_statemsg').textContent='';\n    $('hb_pw').value=''; $('hb_pwerr').textContent='';\n    $('hb_recs').classList.remove('show'); $('hb_recs').innerHTML='';\n    $('hb_reclink').style.display='none';\n    $('hb_cat').classList.remove('jump'); $('hb_bigtag').classList.remove('show');\n    hbFxStop();\n    var btn=$('hb_openbtn'); btn.classList.remove('spin'); btn.disabled=false;\n    var wd=$('hb_wdbtn'); wd.style.display='none'; wd.disabled=false; wd.classList.remove('mini');\n    if(c.mine&&c.mine.claimed){ showResult(c.mine.amount,false,c.mine.best==1,true); if(c.canwd){ wd.classList.add('mini'); wd.style.display='block'; } }\n    else if(c.state!=='open'){ btn.style.display='none'; env.classList.add('opened'); $('hb_amt').textContent=''; $('hb_statemsg').textContent=stateText(c.state); $('hb_reclink').style.display=c.is_sender?'inline':'none'; }\n    else if(c.is_sender&&c.selfclaim){ btn.style.display='block'; wd.classList.add('mini'); wd.style.display='block'; }\n    else if(c.is_sender){ btn.style.display='none'; wd.classList.remove('mini'); wd.style.display='block'; }\n    else { btn.style.display='block'; }\n    $('hb_mask').classList.add('show');\n  });\n};\nfunction stateText(s){return {done:'紅包已被搶光',withdrawn:'紅包已被撤回',expired:'紅包已過期',closed:'紅包已被關閉'}[s]||'紅包已結束';}\nfunction showResult(amount,iscat,best,already){\n  var env=$('hb_env'),btn=$('hb_openbtn');\n  $('hb_amt').textContent=amount; $('hb_statemsg').textContent='';\n  btn.style.display='none'; env.classList.add('opened'); $('hb_reclink').style.display='inline';\n  if(iscat){ $('hb_cat').innerHTML=HB.cat; $('hb_cat').classList.add('jump'); $('hb_bigtag').classList.add('show'); hbFx(amount); }\n  if(HB.cur&&HB.cur.el){ HB.cur.el.classList.add('claimed'); var m=HB.cur.el.querySelector('.claimed-mark'); if(m){m.style.display='block';m.textContent='已領取';} }\n}\nwindow.hongbaoDailyInit=function(cfg){\n  HB.daily=cfg;\n  if(cfg.entry==2){ var f=document.createElement('div'); f.className='float-hb'; f.innerHTML='<div class=\"body\"><div class=\"dot\"></div><div class=\"lbl\">紅包</div></div>'; f.onclick=hongbaoDailyOpen; document.body.appendChild(f); }\n  else { // popup:尊重「今日不再顯示」\n    var skip=null; try{ skip=localStorage.getItem('hb_daily_skip'); }catch(e){}\n    if(skip!=cfg.dateflag){\n      HB.dailyTimer=setTimeout(function(){\n        HB.dailyTimer=null;\n        // 自動彈窗:若使用者已在跟別的紅包互動(卡片開包中),不搶走畫面——下次登入或改用浮標仍可領。\n        if($('hb_mask').classList.contains('show')){ return; }\n        hongbaoDailyOpen();\n      },600);\n    }\n  }\n};\nwindow.hongbaoDailyOpen=function(){\n  var cfg=HB.daily||{}; HB.cur={isdaily:true,tid:0,haspw:false,unit:cfg.unit||'',el:null};\n  var env=$('hb_env'); env.classList.remove('opened','haspw');\n  $('hb_from').textContent=cfg.from||'系統 每日紅包'; $('hb_bless').innerText=cfg.bless||'今日登入紅包';\n  $('hb_who').textContent=cfg.from||'系統 每日紅包'; $('hb_bless2').textContent=(cfg.bless||'今日登入紅包').split('\\\\n')[0];\n  $('hb_unit').textContent=cfg.unit||''; $('hb_amt').textContent=''; $('hb_statemsg').textContent='';\n  $('hb_reclink').style.display='none'; $('hb_recs').classList.remove('show'); $('hb_recs').innerHTML='';\n  $('hb_cat').classList.remove('jump'); $('hb_bigtag').classList.remove('show');\n  hbFxStop();\n  var b=$('hb_openbtn'); b.classList.remove('spin'); b.disabled=false; b.style.display='block';\n  $('hb_wdbtn').style.display='none';\n  var sk=$('hb_dailyskip'); sk.style.display=(cfg.entry==1)?'block':'none';\n  $('hb_skipchk').checked=false;\n  $('hb_mask').classList.add('show');\n};\nfunction hongbaoDoDaily(){\n  var b=$('hb_openbtn'); b.disabled=true;\n  post(HB.base+'daily','formhash='+HB.fh).then(function(r){return r.json();}).then(function(res){\n    b.disabled=false;\n    if(!res.ok){ if(res.already){ b.style.display='none'; $('hb_env').classList.add('opened'); $('hb_statemsg').textContent=res.error||'今天已領過'; } else { alert(res.error||'領取失敗'); } return; }\n    if($('hb_skipchk').checked){ try{ localStorage.setItem('hb_daily_skip',(HB.daily&&HB.daily.dateflag)||''); }catch(e){} }\n    b.classList.add('spin');\n    setTimeout(function(){ showResult(res.amount,false,false,false); $('hb_reclink').style.display='none';\n      if(res.redirect){ setTimeout(function(){ location.href=res.redirect; },1600); } },520);\n  }).catch(function(){ b.disabled=false; alert('網路錯誤'); });\n}\nwindow.hongbaoDoOpen=function(){\n  var c=HB.cur; if(!c) return;\n  if(c.isdaily){ return hongbaoDoDaily(); }\n  var pw=c.haspw?$('hb_pw').value.trim():'';\n  if(c.haspw&&!pw){ $('hb_pwerr').textContent='請輸入口令'; return; }\n  var btn=$('hb_openbtn'); btn.disabled=true;\n  post(HB.base+'grab','tid='+c.tid+'&formhash='+HB.fh+'&password='+encodeURIComponent(pw)).then(function(r){return r.json();}).then(function(res){\n    btn.disabled=false;\n    if(!res.ok){\n      if(res.state==='badpw'){ $('hb_pwerr').textContent=res.error||'口令錯誤'; return; }\n      if(res.state==='needreply'){ alert(res.error||'需先回帖'); hongbaoClose(); return; }\n      alert(res.error||'領取失敗'); if(res.state==='done'){ $('hb_openbtn').style.display='none'; $('hb_env').classList.add('opened'); $('hb_statemsg').textContent='紅包已被搶光'; } return;\n    }\n    btn.classList.add('spin');\n    if(!res.canwd){ $('hb_wdbtn').style.display='none'; }\n    setTimeout(function(){ showResult(res.amount,res.iscat,res.best,false); },520);\n  }).catch(function(){ btn.disabled=false; alert('網路錯誤,請再試一次'); });\n};\nwindow.hongbaoWithdraw=function(){\n  var c=HB.cur; if(!c) return;\n  if(!confirm('確定撤回這個紅包的剩餘份額?已被領走的不會追回,剩餘退回你的帳戶。')) return;\n  var wd=$('hb_wdbtn'); wd.disabled=true;\n  post(HB.base+'withdraw','tid='+c.tid+'&formhash='+HB.fh).then(function(r){return r.json();}).then(function(res){\n    wd.disabled=false;\n    if(!res.ok){ alert(res.error||'撤回失敗'); return; }\n    wd.style.display='none'; $('hb_env').classList.add('opened');\n    $('hb_statemsg').textContent='已撤回,退回 '+res.refunded+' '+(c.unit||'');\n    if(HB.cur.el){ HB.cur.el.classList.add('claimed'); var m=HB.cur.el.querySelector('.claimed-mark'); if(m){m.style.display='block';m.textContent='已撤回';} }\n  }).catch(function(){ wd.disabled=false; alert('網路錯誤'); });\n};\nwindow.hongbaoToggleRecs=function(){\n  var box=$('hb_recs');\n  if(box.classList.contains('show')){ box.classList.remove('show'); return; }\n  fetch(HB.base+'record&tid='+HB.cur.tid,{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(d){\n    if(!d.ok){ alert(d.error||'無法取得記錄'); return; }\n    var h='<div class=\"rh\">已領取 '+d.claimed+'/'+d.shares+' 份</div>';\n    d.recs.forEach(function(x){ h+='<div class=\"rec\"><span>'+esc(x.username)+' · '+esc(x.time)+'</span><span>'+x.amount+' '+esc(d.unit)+(x.isbest?'<span class=\"tag\">手氣最佳</span>':'')+'</span></div>'; });\n    box.innerHTML=h; box.classList.add('show');\n  });\n};\nfunction esc(s){return (''+s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n})();\n</script><script>(function(){function go(){if(window.hongbaoDailyInit){hongbaoDailyInit({\"entry\":1,\"dateflag\":\"20261006\",\"from\":\"系統 每日紅包\",\"bless\":\"今日登入紅包,明天還可以再領\",\"unit\":\"威望\"});}else{setTimeout(go,50);}}go();})();</script><div class=\"dz_footc cl\">\r\n\n"}